#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$SCRIPT_DIR/.venv/bin/python" ]; then
  PIXELIZER_PYTHON="$SCRIPT_DIR/.venv/bin/python"
else
  PIXELIZER_PYTHON=${TRUE_PIXELIZER_PYTHON:-python3}
fi

PYTHONPATH="$SCRIPT_DIR/src${PYTHONPATH:+:$PYTHONPATH}" \
  exec "$PIXELIZER_PYTHON" -m true_pixelizer "$@"
